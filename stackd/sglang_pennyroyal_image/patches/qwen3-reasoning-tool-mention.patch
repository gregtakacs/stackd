+    def _tool_start_confirmed(self, remainder: str) -> Optional[bool]:
+        """Whether `remainder` (the buffered text starting at an occurrence of
+        `tool_start_token`) is really the start of a tool call, as opposed to
+        the model merely quoting or mentioning the literal tag while
+        reasoning in prose (e.g. narrating a system prompt's own tool-call
+        formatting rule). Returns True/False when confident, or None when not
+        enough text has arrived yet after the token to tell -- the streaming
+        caller should keep buffering rather than guess either way.
+
+        The base implementation always confirms, preserving every existing
+        detector's historical behavior; override this in a subclass once its
+        paired tool-call wire format is known well enough to validate against.
+        """
+        return True
+
+    def _find_confirmed_tool_start(self, text: str) -> Tuple[int, Optional[bool]]:
+        """Scan `text` for the first occurrence of `tool_start_token` this
+        detector actually confirms opens a real tool call, skipping any
+        earlier occurrence it rejects (quoted/mentioned in prose) and
+        continuing the search past it -- so a genuine tool call later in the
+        same buffer, including a second of several parallel calls, is still
+        found. Returns:
+          (-1, None)  -- no occurrence found at all.
+          (idx, True) -- a confirmed real tool-call start at idx.
+          (idx, None) -- an occurrence at idx that can't be judged yet because
+                         not enough text has arrived after it; only the LAST
+                         occurrence in `text` can ever come back this way.
+        """
+        search_from = 0
+        while True:
+            idx = text.find(self.tool_start_token, search_from)
+            if idx == -1:
+                return -1, None
+            verdict = self._tool_start_confirmed(text[idx:])
+            if verdict or verdict is None:
+                return idx, verdict
+            search_from = idx + len(self.tool_start_token)
+
