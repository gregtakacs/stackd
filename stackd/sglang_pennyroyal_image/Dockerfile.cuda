# =============================================================================
# SGLang "Pennyroyal" runtime — jpezzulli/sglang-rtxpro6000, built for NVIDIA
# Blackwell (sm_120 / RTX PRO 6000). NOT vanilla SGLang: this fork carries the
# DFLASH speculative path, mamba-radix HiCache, gdn-mtp-cache-mode, the
# FlashInfer linear-attn backends, ple-offload-embedding and the page_first
# HiCache layout that the config/models/*-next.yaml cmd_extra depends on.
#
# Produced by `docker exec stackd stackctl build coding-next` (or chat-next) —
# stackd tars this directory and streams it to the Docker Engine /build API
# (stackd/builder.py). Tag: ${SGLANG_PENNYROYAL_IMAGE} (AI-STACK/.env).
#
# HIGH-RISK BUILD. The fork's own BUILD.md / RUN.md at ref
# `pennyroyal-v2.3.1` is the source of truth for exact versions and flags; the
# steps below are transcribed from it and its launchers and are expected to need
# a round or two of build-fix iteration. Rollback lever: SGLANG_FORK_REF below
# (previous known-good: 38a5ecbabe957b77f66f6d4ecf91f7f8c36531ab).
#
# compose-version-audit (Docker-Tools/compose-version-audit) tracks the pins here
# against upstream like the other stackd-built images — see
# LLM-Tools/stackd/stackd-images.audit.yml.
# ---------------------------------------------------------------------------
# Single-stage on the CUDA 13.3 devel base: the runtime is a Python venv full of
# compiled CUDA extensions + NIXL's meson-installed libs, which do not survive a
# naive COPY into a slim stage. Slimming to two stages is a later optimisation.
# Pinned by digest — nvidia/cuda:*-devel tags are mutable (see the llama.cpp
# Dockerfile's note on why the digest matters). 13.3.1-devel-ubuntu24.04 as of
# 2026-09-06.
FROM nvidia/cuda:13.3.1-devel-ubuntu24.04@sha256:4ff859525f99de5782aa73607ce24219b07dddd48d12b97c1c301d7e1cfb0a87

ARG SGLANG_FORK_REPO=https://github.com/jpezzulli/sglang-rtxpro6000.git
# Pinned to release tag pennyroyal-v2.5.0 (released 2026-09-12). Bumped
# 2026-09-12 from pennyroyal-v2.4.0 (94324164715b45386de1789070ceb258333d08cc);
# rollback lever: set SGLANG_FORK_REF back to that tag. Skips the intervening
# v2.4.1 (pure maintenance, no rebase, "no urgent need to update" per its own
# CHANGES.md) — v2.5.0's lineage is a strict superset of it.
#   v2.3     — Flash-Next FR-Spec: 65,536-token draft map + launcher/map-builder.
#   v2.3.1   — GDN gate-rounding correctness fix on the 27B FP8/DFlash2 Triton
#              verify path. Flash-Next's FlashInfer/WY path UNCHANGED.
#   v2.3.1.1 — bundles the Froggeric v22.5 chat template at
#              configs/pennyroyal/templates/; launchers add
#              --image-processor-backend pil. Executable unchanged from v2.3.1.
#   v2.4.0   — 11 fork commits on top of v2.3.1.1, NO upstream rebase, same
#              dependency stack + launch settings. Runtime changes: (a)
#              qwen3_coder phantom tool-call fix — adapts our upstream PR
#              sgl-project/sglang#38624 (wrapper gate + declared-name check),
#              so the local patches/qwen3-coder-streaming-phantom-toolcall.patch
#              was RETIRED (deleted, see git history if it ever needs restoring);
#              (b) release abandoned streaming work + request resources on
#              client disconnect / cancel-around-dispatch; (c) explicit Chat
#              reasoning_effort now wins over the launcher default; (d) QSA
#              prefill reuse + short-extend bounds; (e) MoE zero-bias routing
#              removal + PDL input fence.
#   v2.4.1   — maintenance only (grammar-history GC, streaming alt-token probs,
#              pinned-host async transfer buffers, PLE hash/lookup combine).
#              SKIPPED here — folded into v2.5.0's lineage, no separate build.
#   v2.5.0   — SAME dependency stack + launch settings as v2.4.0/.1 (BUILD.md:
#              no PyTorch/sglang-kernel/FlashInfer/NIXL rebuild needed for a
#              native update — this Dockerfile still does a full checkout+
#              install since each image build starts clean). Two NEW opt-in
#              Flash-Next capabilities, both OFF unless a model YAML's
#              container.env sets them:
#              (a) SGLANG_SM120_ONLINE_MXFP8=true — online FP8: converts
#                  eligible BF16 transformer projections + HyperConnection mix
#                  weights + output head to MXFP8/row-wise FP8 at load time.
#                  NVFP4 experts/PLE/FP8 KV/BF16 GDN state untouched. Vendor
#                  numbers: +28.3%/+26.5%/+15.8% decode at short/128K/490K
#                  context, and MORE free VRAM post-graph-capture (not less).
#              (b) PENNY_PLE_BACKEND=nvme + PENNY_PLE_NVME_MODEL=<path> —
#                  streams the ~47.68 GiB PLE table from a prepared local-NVMe
#                  overlay instead of pinning it in RAM. Needs the isolated
#                  Rust/Cargo-built reader below plus a one-time
#                  prepare_ple_nvme.py snapshot (see AI-STACK's coding-img.yaml
#                  for the overlay path). Vendor's own A/B: ~14% aggregate
#                  decode-throughput cost vs RAM PLE on their fast NVMe — a
#                  real tradeoff, not a free win; only worth it to shrink host
#                  RAM enough for iGPU image-gen co-residency (coding-img).
#              Also: structured-output startup warmup, a PLE-loader GC leak
#              fix, explicit MAX_TOTAL_TOKENS overrides. RUN.md: a source
#              change always selects a fresh NIXL namespace — bump
#              SGLANG_HICACHE_NIXL_BACKEND_STORAGE_DIR in every model YAML that
#              changed cmd_extra/env identity (coding-long -v5->-v6; coding-img
#              is new, starts at -v1).
#   v2.5.1   — Bumped 2026-09-17. SAME CUDA/PyTorch/FlashInfer/NIXL stack as
#              v2.5.0 (its own CHANGES.md says so explicitly) — this bump is
#              purely to pick up native fixes for two bugs this repo was
#              carrying local patches/workarounds for:
#              (a) the reasoning_parser tool_start_token false-positive
#                  (jpezzulli/sglang-rtxpro6000#6) — retired
#                  patches/qwen3-reasoning-tool-mention.patch, see the
#                  RETIRED note at the git-checkout step below;
#              (b) qwen3_coder tool examples inside fenced code blocks now
#                  stay as text (a sibling of the phantom-tool-call bug
#                  v2.4.0 already fixed for the unfenced case).
#              Also: host-cache eviction keeps recurrent-state endpoints over
#              redundant checkpoints (jpezzulli/sglang-rtxpro6000#3), skips
#              donating an unfinished-request checkpoint when cache slots are
#              busy instead of aborting (adapted from sglang#37619), a QSA
#              chunked-prefill boundary fix (adapted from sglang#39575), and
#              an optional C6 (1,048,576 shared KV token) Flash-Next launch
#              profile — opt-in, not used by any model YAML here.
#   v2.5.2   — SKIPPED (folded into v2.5.3's linear lineage). PLE table built
#              host-side instead of GPU-first, exact-sized pinned backing,
#              QSA single-gather prefill, HiCache shortfall-only reclaim, TP2
#              prep, and the launchers now export
#              SGLANG_FORWARD_UNKNOWN_TOOLS=true. That last one is launcher-
#              only (server default still off) and deliberately NOT adopted
#              here: stackd's serve._extract_leaked_toolcall recovers a
#              hallucinated-name call from the dropped-to-text form by
#              parameter shape, which beats forwarding a bogus name for Cline
#              to fail on (AI_NoSuchToolError).
#   v2.5.3   — Bumped 2026-10-04 from v2.5.1 (dbc1e9be), 45 commits, NO
#              rebase, SAME dependency stack (BUILD.md). (a) Fork issue #17:
#              native MTP checkpointed the recurrent state at the wrong
#              accepted-token boundary -> phantom tokens / broken file
#              writes; a plausible root cause under some of the tool-call
#              corruption serve.py's gate still screens for. (b) BF16 NVMe
#              PLE staging sizing (we run the FP8 table, unaffected). (c)
#              qwen3_coder streams string tool arguments incrementally —
#              serve._ToolCallGate folds fragments per index, so still fine,
#              but it holds the call whole, so clients don't see the progress.
#              (d) quoted tool markup split across reasoning chunks. (e)
#              HiCache NIXL: hybrid (Mamba) storage-component count fix +
#              write-through backup fix — changes what lands on disk, so
#              every model YAML's NIXL namespace was bumped with this. Also
#              parallel prompt tokenization (>=32K chars), `thinking` <->
#              `enable_thinking` mirroring, optional l3_cleaner_max_cache_gb.
#              Re-verified at v2.5.3: qwen3_coder _is_declared_tool gate and
#              reasoning_parser _tool_start_confirmed both still present;
#              upstream froggeric-v22.5.jinja byte-identical to v2.5.1's (our
#              vendored copy differs only by our own line 209); ple-backend.sh,
#              check_ple_nvme.py, ple_nvme/install.sh, nixl-posix.toml all
#              unchanged, so entrypoint.sh's NVMe wiring needs no update.
#              Rollback: v2.5.1 image tagged sglang-pennyroyal:v2.5.1.
#   v3.0.0/.1 — Bumped 2026-10-13 from v2.5.3, 221 commits, linear (no
#              rebase). MAJOR: same PyTorch 2.13.0 / sglang-kernel 0.4.6.post1
#              / NIXL_REF, but FlashInfer 0.6.17 -> 0.7.0.post1 PLUS a new
#              mandatory packaging step (scripts/pennyroyal/flashinfer/
#              install.py: git-applies the fork's accepted SM120 MoE/GDN
#              sources onto the installed flashinfer package and AOT-builds
#              fused_moe_120.so) and the matching flashinfer-jit-cache wheels
#              — see the install steps below, transcribed from BUILD.md and the
#              fork's own docker/pennyroyal/Dockerfile. Runtime: adaptive MTP
#              (launcher-level opt-in: --speculative-adaptive + policy file,
#              steps 7 / draft tokens 8 — set in the model YAMLs), online FP8
#              now AUTOMATIC when SGLANG_SM120_ONLINE_MXFP8 is unset (explicit
#              true is a force/debug hatch — removed from the YAMLs), patched
#              FlashInfer GDN FP16-accumulate mode (FLASHINFER_GDN_FP16_ACCUM_MMA,
#              launcher default 1, set in the YAMLs), new persistent-cache
#              identities (NIXL namespaces bumped in every YAML). v3.0.1: NVMe
#              PLE reader compatibility hashes fixed (v3.0.0's stale hashes
#              refused to start NVMe PLE — our floor stack's mode), TileLang
#              cache moved under the cache dir (TILELANG_CACHE_DIR below).
#              ple-backend.sh moved scripts/ -> configs/pennyroyal/; its nvme
#              branch is unchanged, so entrypoint.sh's replica still matches.
#              Re-verified at v3.0.1: _is_declared_tool / SGLANG_FORWARD_
#              UNKNOWN_TOOLS (still launcher-only, still NOT adopted) and
#              _tool_start_confirmed present; froggeric-v22.5.jinja upstream
#              unchanged (ours still differs only by our line 209);
#              check_ple_nvme.py unchanged. Rollback: v2.5.3 image tagged
#              sglang-pennyroyal:v2.5.3.
#   v3.1.4   — Bumped 2026-11-01 from v3.0.1 (skips v3.1.0-.3), 223 commits,
#              linear (no rebase). SAME PyTorch 2.13.0 / FlashInfer 0.7.0.post1
#              / sglang-kernel 0.4.6.post1 / NIXL 1.4.0 @ aecbc38 / CUDA 13.3.
#              PACKAGING REWORK: the fork dropped the constraints.txt + resolver
#              install for an exact-pin one — docker/pennyroyal/native-
#              baseline.json names every distribution (transitive deps too) of
#              its qualified native venv, installed --no-deps per index via
#              scripts/pennyroyal/dependency_parity.py, then gated by
#              check_dependencies.py + `dependency_parity.py check`. NIXL now
#              builds as real nixl-cu13/nixl wheels via the fork's
#              docker/pennyroyal/build-nixl.sh, which retires our meson-install
#              + _nixl_system.pth bridge AND the pip-check allowlist line it
#              needed. Python is the baseline's exact 3.12.13 (uv bumped to a
#              release that ships it). Runtime: KV pool auto-sized (no preset
#              cap; our YAMLs never set one); FR-Spec static fraction 0.981 ->
#              0.97 (fork PR #95, headroom once the cap went); adaptive-next.json
#              is now the `tiered` width policy (W8 at C1, W4 at C>=2 — the
#              maintained default; the old acceptance-adaptive file is
#              adaptive-next-v3.0.2.json); NVMe PLE source-hash gate removed
#              (v3.1.1); hybrid-Mamba truncated-chunk keys page-floored + short
#              NIXL restores refused (v3.1.3) — NIXL namespaces bumped in every
#              YAML. Re-verified at v3.1.4: froggeric-v22.5.jinja, nixl-posix.toml,
#              ple-backend.sh's nvme branch upstream unchanged (entrypoint.sh
#              needs no update). Rollback: v3.0.1 image tagged
#              sglang-pennyroyal:v3.0.1.
# BUILD.md @ v3.1.4 keeps the toolchain this Dockerfile uses (Python 3.12.13,
# CUDA 13.3, GCC 15, PyTorch 2.13.0+cu130). The git-checkout layer changes, so
# a from-scratch ~20 min sm120 rebuild.
ARG SGLANG_FORK_REF=pennyroyal-v3.1.4
# Exact interpreter of the fork's native-baseline.json ("qualified.python").
ARG PYTHON_VERSION=3.12.13

ENV DEBIAN_FRONTEND=noninteractive

# --- toolchain: GCC 15 (fork validated on 15.3.1), git, meson/ninja for NIXL ---
# The ubuntu-toolchain-r/test PPA carries gcc-15 for noble. Added by hand (apt
# source line + keyserver-fetched signing key) rather than `add-apt-repository`,
# whose launchpadlib API call is a flaky single point of failure (observed:
# Launchpad HTTP 504 mid-build). Key 0x...BA9EF27F is the well-known
# ubuntu-toolchain-r archive-signing key.
ARG TOOLCHAIN_PPA_KEY=60C317803A41BA51845E371A1E9377A2BA9EF27F
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git gnupg \
        build-essential ninja-build meson pkg-config cmake protobuf-compiler \
        libnuma-dev libibverbs-dev librdmacm-dev libaio-dev liburing-dev \
    && for i in 1 2 3 4 5; do \
         curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&options=mr&search=0x${TOOLCHAIN_PPA_KEY}" \
           | gpg --dearmor -o /usr/share/keyrings/ubuntu-toolchain-r.gpg && break || sleep 15; \
       done \
    && test -s /usr/share/keyrings/ubuntu-toolchain-r.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/ubuntu-toolchain-r.gpg] https://ppa.launchpadcontent.net/ubuntu-toolchain-r/test/ubuntu noble main" \
       > /etc/apt/sources.list.d/ubuntu-toolchain-r.list \
    && apt-get update && apt-get install -y --no-install-recommends g++-15 gcc-15 \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-15 150 \
       --slave /usr/bin/g++ g++ /usr/bin/g++-15 \
    && rm -rf /var/lib/apt/lists/*

# --- uv (pinned) ------------------------------------------------------------
# 0.12.24: first pin that ships python-build-standalone 3.12.13 (0.9.2 topped
# out at 3.12.12), which the v3.1 baseline requires exactly.
ARG UV_VERSION=0.12.24
RUN curl -LsSf https://astral.sh/uv/${UV_VERSION}/install.sh | sh
ENV PATH=/root/.local/bin:${PATH}

# --- Rust/Cargo (pinned) — only needed to build the optional NVMe PLE reader
# (tools/ple_nvme, an attributed adaptation of ai-dynamo/nixl-adjacent SSD
# Stream; see NVME-PLE.md). Built unconditionally so both coding-long (RAM PLE,
# unused) and coding-img (NVMe PLE) share one image; PENNY_PLE_BACKEND stays
# unset for coding-long so the plugin is never imported (per NVME-PLE.md:
# "imported only in NVMe mode").
ARG RUST_VERSION=1.97.1
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --default-toolchain ${RUST_VERSION} --profile minimal
ENV PATH=/root/.cargo/bin:${PATH}

# --- compiler / build-parallelism env (from the fork's serve-*.sh) ---------
ENV CUDA_HOME=/usr/local/cuda \
    CUDACXX=/usr/local/cuda/bin/nvcc \
    CC=/usr/bin/gcc-15 CXX=/usr/bin/g++-15 CUDAHOSTCXX=/usr/bin/g++-15 \
    TORCH_CUDA_ARCH_LIST=12.0 \
    CMAKE_CUDA_ARCHITECTURES=120a \
    MAX_JOBS=24 CMAKE_BUILD_PARALLEL_LEVEL=24 \
    FLASHINFER_NINJA_JOBS=24 FLASHINFER_NVCC_THREADS=4 \
    TORCHINDUCTOR_COMPILE_THREADS=24 \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64

WORKDIR /opt/pennyroyal

# --- the fork + its venv --------------------------------------------------
RUN git clone --recursive ${SGLANG_FORK_REPO} . \
    && git checkout ${SGLANG_FORK_REF} \
    && git submodule update --init --recursive

# RETIRED 2026-09-17: patches/qwen3-reasoning-tool-mention.patch (the
# reasoning_parser tool_start_token false-positive fix -- a bare/malformed
# <tool_call> mention during reasoning no longer ends thinking early or leaks
# </think> -- filed as jpezzulli/sglang-rtxpro6000#6) is now incorporated
# natively in pennyroyal-v2.5.1 per that release's CHANGES.md. Patch file
# deleted; git history has it if it's ever needed against an older pin.
# Re-verify after any future rebase the same way v2.4.0's retired qwen3_coder
# patch was: grep the built image's reasoning_parser.py for
# `_tool_start_confirmed`. VERIFIED PRESENT at v2.5.1 (2026-09-17) -- the fork
# adopted our contributed fix's own implementation (CHANGES.md credits
# "community issue #6"), same hook name, just native now instead of a
# git-apply. If a future rebase ever DROPS this hook entirely, that's the
# signal the fix regressed or was reimplemented differently -- re-check the
# actual behavior (quoting a bare/malformed <tool_call> during reasoning must
# not end thinking early), not just the symbol's presence.
#
# The Froggeric v22.5 chat template used to be vendored right here, right
# after checkout -- moved to the END of this file (with the other late COPY
# steps) 2026-09-17: copying it this early invalidated Docker's build cache
# for EVERY step after it (venv, all the pip installs, NIXL, the Rust PLE
# reader) on every template-only edit, forcing the full from-scratch reinstall
# that's normally only expected on a real SGLANG_FORK_REF bump (see that ARG's
# comment above). Root-caused live: the second such edit (2026-09-17, the
# tool-name anti-example) triggered exactly that full reinstall via the `uv
# pip install --prerelease=allow --index-strategy unsafe-best-match` below
# resolving something differently than the already-running image, and the
# resulting container hung mid-boot in FlashInfer's MXFP8 autotune --
# reproduced twice. Fixed by moving the COPY, not by touching the install
# command (that flag combo is the fork's own documented BUILD.md recipe, not
# something to tighten blind).

RUN uv python install ${PYTHON_VERSION} \
    && uv venv --python ${PYTHON_VERSION} .venv
ENV VIRTUAL_ENV=/opt/pennyroyal/.venv PATH=/opt/pennyroyal/.venv/bin:${PATH}

# v3.1: dependencies are INSTALLED, not resolved — transcribed from the fork's
# own docker/pennyroyal/Dockerfile. native-baseline.json pins every distribution
# of the qualified native venv (build backends, torch/FlashInfer +cu130 builds,
# the jit-cache providers and transitive deps alike); each index's group goes in
# --no-deps so no resolver can add or move anything (this also closes the
# 2026-09-17 resolver-drift class of failure for good). Then the editable sglang
# install, also --no-deps, and the fork's two gates before the compile below.
RUN for index in $(python scripts/pennyroyal/dependency_parity.py indexes); do \
         python scripts/pennyroyal/dependency_parity.py requirements \
           --index "$index" > /tmp/penny-pins.txt \
         && uv pip install --no-deps --prerelease=allow \
              --index-url "$index" -r /tmp/penny-pins.txt; \
       done \
    && rm -f /tmp/penny-pins.txt
RUN SETUPTOOLS_SCM_PRETEND_VERSION_FOR_SGLANG="0.5.19+g$(git rev-parse --short=12 HEAD)" \
      CARGO_TARGET_DIR=/tmp/penny-cargo \
      uv pip install --no-deps --no-build-isolation-package sglang -e python \
    && rm -rf /tmp/penny-cargo \
    && python scripts/pennyroyal/flashinfer/check_dependencies.py \
    && python scripts/pennyroyal/dependency_parity.py check --pending-source-build

# The fork's packaging step patches the installed FlashInfer with its accepted
# SM120 MoE/GDN sources and AOT-builds fused_moe_120.so (no GPU/download needed;
# nvcc + git apply). Job count throttled — this box OOM'd a 24-parallel CUDA
# compile before.
ARG FLASHINFER_BUILD_JOBS=4
RUN MAX_JOBS=${FLASHINFER_BUILD_JOBS} FLASHINFER_NINJA_JOBS=${FLASHINFER_BUILD_JOBS} \
    FLASHINFER_NVCC_THREADS=1 FLASHINFER_WORKSPACE_BASE=/tmp/penny-fi-sm120 \
    python scripts/pennyroyal/flashinfer/install.py \
    && python scripts/pennyroyal/flashinfer/install.py --check \
    && rm -rf /tmp/penny-fi-sm120

# --- NIXL 1.4.0 (POSIX FILE plugin) — HiCache L3 persistence backend ------
# v3.1: built by the fork's own docker/pennyroyal/build-nixl.sh (NIXL commit
# pinned inside it, still aecbc38) as real nixl-cu13 + nixl wheels in the venv,
# with the POSIX plugin bundled — the parity gate below expects both
# distributions with metadata, which our old meson-install + .pth bridge never
# produced. Assert the venv import and the POSIX plugin before moving on.
RUN bash docker/pennyroyal/build-nixl.sh \
    && python -c "from nixl._api import nixl_agent, nixl_agent_config; print('nixl venv import OK')"

# --- optional NVMe PLE reader (v2.5.0, tools/ple_nvme) ----------------------
# Isolated Rust/Cargo build, separate from the main venv per NVME-PLE.md ("does
# not alter the main environment"). Baked into the image at a fixed path so
# runtime doesn't depend on build-time CWD. CARGO_BUILD_JOBS throttled to 4 for
# the same reason as the FlashInfer JIT settings below (this box OOM'd a
# 24-parallel compile once already, see coding-long.yaml history) even though
# this build is much lighter than the CUDA kernel JIT.
ENV PENNY_PLE_PLUGIN_DIR=/opt/pennyroyal/.ple-nvme
RUN CARGO_BUILD_JOBS=4 PYTHON=/opt/pennyroyal/.venv/bin/python \
      bash tools/ple_nvme/install.sh

# v3.1: the fork's closing gates, exactly as its own build stage runs them —
# requirement closure, then full parity against native-baseline.json (now with
# the two source-built NIXL wheels, so no --pending-source-build), then the
# packaged FlashInfer module. No local exemptions any more: our NIXL is the
# fork's wheel build now. The freeze is the record of what this image installed.
RUN python scripts/pennyroyal/flashinfer/check_dependencies.py \
    && python scripts/pennyroyal/dependency_parity.py check \
    && python scripts/pennyroyal/flashinfer/install.py --check > /dev/null \
    && python -m pip freeze > /opt/pennyroyal-container-packages.txt \
    && echo 'dependency gates passed (check_dependencies + baseline parity)'

# Late runtime deps kept out of the ~20 min sm120 build cache above:
#  * ffmpeg    — torchcodec dlopen's libavutil.so.* at import; without it every
#                startup spews OSError tracebacks (harmless for text, just noise)
#  * libssl-dev — SGLang JIT-builds `hicache_hash_cpp` (#include <openssl/sha.h>)
#                the first time an L3 storage backend (NIXL) is active
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# --- stable runtime env (from the fork's serve-*.sh; box-specific vars stay
#     in the model YAML's container.env). Cache dirs point at /cache, a bind
#     mount (AI-STACK: ${DOCKERDIR}/appdata/sglang-cache) so torch.compile /
#     FlashInfer JIT / triton output survives a container recreate. ----------
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    SGLANG_NUMA_BIND_V2=false \
    SGLANG_ALLOW_OVERWRITE_LONGER_CONTEXT_LEN=1 \
    OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 TOKENIZERS_PARALLELISM=false \
    CACHE_BASE=/cache \
    HF_HOME=/cache/huggingface XDG_CACHE_HOME=/cache \
    TORCH_HOME=/cache/torch TORCHINDUCTOR_CACHE_DIR=/cache/torchinductor \
    TRITON_CACHE_DIR=/cache/triton CUDA_CACHE_PATH=/cache/cuda \
    FLASHINFER_WORKSPACE_BASE=/cache/flashinfer \
    SGLANG_CACHE_DIR=/cache/sglang SGLANG_JIT_CACHE_DIR=/cache/sglang/jit \
    TORCH_EXTENSIONS_DIR=/cache/torch_extensions \
    TILELANG_CACHE_DIR=/cache/tilelang \
    SGLANG_MM_PREPROCESS_DEVICE=cpu NUMPY_MADVISE_HUGEPAGE=0
# ^ v3.0.1 puts TileLang's compiled kernels under the cache dir by default;
#   set explicitly here so it's on the /cache bind mount regardless. The last
#   two are the v3 launchers' defaults (CPU image preprocessing, matching our
#   --image-processor-backend pil; no NumPy huge-page madvise).

# NIXL POSIX-FILE backend config for phase-2 HiCache persistence. Baked in (vs a
# host mount) since it changes rarely; the model YAML references it with
# `--hicache-storage-backend-extra-config @/etc/pennyroyal/nixl-posix.toml`. The
# l3_cleaner watermarks are WHOLE-FILESYSTEM occupancy % — tuned here for the
# WD_BLACK 4 TB (${DOCKERDIR} fs) that holds /nixl; recalculate if that changes.
COPY nixl-posix.toml /etc/pennyroyal/nixl-posix.toml

COPY entrypoint.sh /usr/local/bin/pennyroyal-entrypoint
RUN chmod +x /usr/local/bin/pennyroyal-entrypoint

# Vendor our own copy of the fork's bundled Froggeric v22.5 chat template
# (extracted from the sglang-pennyroyal:local image built at pennyroyal-v2.5.0,
# 2026-09-17) instead of trusting it silently on every future SGLANG_FORK_REF
# bump — this file controls the exact tool-call instructions/format the model
# is prompted with (qwen3.8-flash-next.yaml's cmd_extra selects `xml` vs
# `json` via chat_template_kwargs.tool_call_format; --tool-call-parser must
# match: qwen3_coder for xml, hermes for json). Before ever bumping
# SGLANG_FORK_REF, diff this file against a fresh clone's
# configs/pennyroyal/templates/froggeric-v22.5.jinja and re-vendor
# deliberately. Placed HERE (last, after every dependency-install step)
# deliberately — see the RETIRED note near the git-checkout step above for
# why: this exact COPY used to sit right after checkout and forced a full
# from-scratch dependency reinstall on every template-only edit, which is
# what caused the 2026-09-17 boot hang.
COPY templates/froggeric-v22.5.jinja configs/pennyroyal/templates/froggeric-v22.5.jinja

# The qwen3_coder phantom tool-call hotfix that lived here (a local git-apply of
# patches/qwen3-coder-streaming-phantom-toolcall.patch, our upstream PR
# sgl-project/sglang#38624) is RETIRED as of the v2.4.0 fork bump above: v2.4.0
# carries "Validate qwen3_coder wrappers and tool names without losing prose"
# (fork commits dba83fad2 / 7f3c4bf48), an adaptation of #38624. Verified the
# tag's qwen3_coder_detector.py has the is_inside_tool_call gate + _is_declared_tool
# + SGLANG_FORWARD_UNKNOWN_TOOLS handling. If a future fork bump drops it, restore
# the patch from git history + AI-STACK/scripts/tool-call-probes/.

EXPOSE 8001
# stackd's SglangPennyroyalAdapter passes the whole arg list as the container
# command (== `container.cmd_extra` + the injected --served-model-name), so the
# entrypoint just prepares cache dirs and exec's `sglang serve "$@"`.
ENTRYPOINT ["/usr/local/bin/pennyroyal-entrypoint"]
