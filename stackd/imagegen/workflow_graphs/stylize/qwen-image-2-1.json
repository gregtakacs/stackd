{
  "1": {
    "inputs": { "image": "example.png", "upload": "image" },
    "class_type": "LoadImage",
    "_meta": { "title": "Input Image" }
  },
  "2": {
    "inputs": {
      "upscale_method": "bilinear",
      "scale_by": 1.0,
      "image": ["1", 0]
    },
    "class_type": "ImageScaleBy",
    "_meta": { "title": "Scale Image By (the stylize upscale_by knob)" }
  },
  "3": {
    "inputs": {
      "unet_name": "qwen_image_2.1_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Diffusion Model (Qwen-Image 2.1, int8 convrot)" }
  },
  "4": {
    "inputs": {
      "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
      "type": "qwen_image",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load CLIP (Qwen3-VL 8B, qwen_image)" }
  },
  "5": {
    "inputs": { "vae_name": "qwen_image_2.1_vae_bf16.safetensors" },
    "class_type": "VAELoader",
    "_meta": { "title": "Load VAE (Qwen-Image 2.1)" }
  },
  "6": {
    "inputs": {
      "model": ["3", 0],
      "device": "auto",
      "dtype": "default"
    },
    "class_type": "QwenImage21Cache",
    "_meta": { "title": "Reference Prefix KV Cache" }
  },
  "7": {
    "inputs": {
      "clip": ["4", 0],
      "prompt": "",
      "negative_prompt": "",
      "vae": ["5", 0],
      "resolution": 0,
      "images.image_1": ["2", 0]
    },
    "class_type": "TextEncodeQwenImage21",
    "_meta": {
      "title": "Style Prompt over the Reference (Qwen holds composition through the reference conditioning the way klein holds it through ReferenceLatent; slot 2 is the image-sized latent)"
    }
  },
  "8": {
    "inputs": {
      "seed": 624434243596488,
      "control_after_generate": "randomize",
      "steps": 25,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1,
      "model": ["6", 0],
      "positive": ["7", 0],
      "negative": ["7", 1],
      "latent_image": ["7", 2]
    },
    "class_type": "KSampler",
    "_meta": { "title": "KSampler (25-step, cfg 1, euler/simple, denoise 1 -- composition held by the reference, same role as klein's ReferenceLatent)" }
  },
  "9": {
    "inputs": {
      "samples": ["8", 0],
      "vae": ["5", 0],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 8
    },
    "class_type": "VAEDecodeTiled",
    "_meta": { "title": "VAE Decode (Tiled)" }
  },
  "10": {
    "inputs": {
      "filename_prefix": "QI21_stylized",
      "images": ["9", 0]
    },
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" }
  }
}
