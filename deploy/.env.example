# stackd standalone deployment — copy to deploy/.env and edit.
#
# Bind-mounted into the stackd container, so after an edit:
#   docker compose exec stackd stackctl reload    # re-reads config + this file, no restart
# Exceptions that need `docker compose up -d stackd` (they also shape the compose
# file itself): DOCKERDIR, STACKD_NETWORK, the published ports.

# ── paths ─────────────────────────────────────────────────────────────────────
# Host directory that holds your data tree. stackd expects, under it:
#   $DOCKERDIR/appdata/llm-models/        your GGUF / vLLM / checkpoint files
#   $DOCKERDIR/appdata/comfyui/models/    ComfyUI checkpoints, loras, vae, ...
#   $DOCKERDIR/appdata/comfyui/scratch/   (created automatically) generation scratch
DOCKERDIR=/srv/stackd
# Absolute path to this repo checkout on the host — only used to bind-mount the
# CLIPSeg custom node into the CUDA ComfyUI. Set it to wherever you `git clone`d.
STACKD_SRC=/opt/stackd

TZ=UTC

# ── network + auth ───────────────────────────────────────────────────────────
STACKD_NETWORK=stackd-net           # the bridge net; engine containers stackd creates join it (match compose)
STACKD_API_KEY=change-me            # bearer for /v1 + control plane. Blank = no auth (localhost only).
# 1 -> `docker compose down` (SIGTERM) also tears down every engine stackd spawned.
# Leave blank if you use `docker compose restart stackd` / rebuilds — you want the
# engines kept there. `stackctl down` always tears down regardless of this.
STACKD_TEARDOWN_ON_SIGTERM=
MCP_API_KEY=change-me               # bearer for the image MCP at :8000/mcp. Blank = no auth.
OPEN_WEBUI_SECRET_KEY=change-me-long-random   # only used with `--profile full`

# Model id stackd asks for image-prompt rewriting (must be a `serves:` name in your
# config, or set LLM_REWRITE_ENABLE=0 in the compose to disable rewriting).
LLM_REWRITE_MODEL=assistant-nothink

# ── GPU / memory (reference: 1x RTX PRO 6000 96GB + AMD Strix Halo iGPU, 128GB) ─
CUDA_VRAM_GIB=95.6            # dedicated VRAM on your discrete GPU (nvidia-smi total, minus a little)
HOST_RAM_GIB=128             # total system RAM
HOST_RESERVE_GIB=28          # RAM the OS + everything that ISN'T stackd uses at rest
IGPU_VRAM_BUDGET_GIB=90      # GTT ceiling for an integrated GPU (set 1 and don't place models on igpu0 if none)

# ── integrated-GPU access (Linux; ignore if you have no iGPU profile) ─────────
IGPU_RENDER_NODE=/dev/dri/renderD128   # fallback only — see below
# renderD* is assigned by PCI enumeration order and WILL silently shift to point at the wrong GPU
# if any other PCI device (a discrete/eGPU, an added NVMe/OCuLink card, ...) changes what enumerates
# before it — this can happen on a routine reboot. Fixed properly: stackd/gpu_discovery.py
# re-derives the AMD iGPU's actual current render node from PCI sysfs (vendor 0x1002 +
# display-controller class) on every config load, and that detected value overrides this one — so
# this line is now just the fallback for when no AMD GPU is found (e.g. stackd running off the real
# host, or a non-AMD iGPU — gpu_discovery.py only matches AMD today). Multiple AMD GPUs are matched
# in PCI-address order (lowest first -> igpu0), same idea as the (currently NVIDIA-only, so unused
# here) `gpus: all` cuda device_profile — see stackd/gpu_discovery.py for details.
VIDEO_GID=44                           # `getent group video  | cut -d: -f3`
RENDER_GID=990                         # `getent group render | cut -d: -f3`
HSA_GFX_VERSION=11.5.1                 # AMD iGPU arch override (Strix Halo gfx1151 -> 11.5.1)

# ── engine images (stackd pulls / builds these for the containers it creates) ─
LLAMACPP_CUDA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LLAMACPP_VULKAN_IMAGE=ghcr.io/ggml-org/llama.cpp:server-vulkan
VLLM_IMAGE=vllm/vllm-openai:latest
COMFYUI_CUDA_IMAGE=yanwk/comfyui-boot:cu130-megapak-pt211-20260826

# ROCm ComfyUI — local build via `docker compose exec stackd stackctl build image:vulkan`
COMFYUI_ROCM_IMAGE=comfyui-rocm:local
COMFYUI_ROCM_BASE=rocm/pytorch:rocm7.14.1_ubuntu24.04_py3.12_pytorch_release_2.12.0
COMFYUI_ROCM_REF=master               # pin to a commit for reproducible builds

# ── private config overlay (optional) ────────────────────────────────────────
# A 2nd config dir that wins PER FILE over the shipped config/. Drop your private
# pools.yaml / models/*.yaml / catalog/*.json here and keep config/ pristine.
# Uncomment the matching volume in docker-compose.yml, then put files under
# ./config.local/ (models/, profiles/, catalog/, *.yaml). An empty overlay file
# deletes that base entry. `stackctl reload` re-reads it live.
#STACKD_CONFIG_OVERLAY=/app/config.local
